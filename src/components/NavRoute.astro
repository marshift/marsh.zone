---
export interface Props {
    href: string;
    title: string;
}

const { href, title } = Astro.props;

const hasLogo = href === "/";
const path = Astro.url.pathname;
const fixedPath = path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;
---

<style lang="scss">
    @use "@/styles/colors";
    @use "@/styles/macros";
    @use "@/styles/fonts";

    .nav-route {
        color: colors.$text-normal;

        &[data-has-logo] {
            @include macros.centered-row;
            font-size: fonts.$size-large;
            margin-right: auto;
        }

        &[data-is-current-route] {
            color: colors.$text-bright;
        }
    }
</style>

<a 
    class="nav-route"
    href={href}
    data-has-logo={hasLogo}
    data-is-current-route={fixedPath === href}
>
    {hasLogo && <img
        src="/images/pinky.png"
        alt="Image of Pinky, from Terraria, used as the site logo"
        width="24px"
    />}
    {title}
</a>
